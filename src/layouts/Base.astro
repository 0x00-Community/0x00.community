---
import { href, localeOf, locales, switchLocale, ui } from '../i18n';

interface Props {
	title?: string;
	description?: string;
}
const locale = localeOf(Astro.url.pathname);
const t = ui[locale];
const { title, description = t.siteDescription } = Astro.props;
const fullTitle = title ? `${title} · 0x00 Community` : '0x00 Community';
const section = Astro.url.pathname.replace(/^\/zh-CN/, '').split('/')[1] ?? '';
const nav = [
	{ key: 'projects', label: t.nav.projects },
	{ key: 'blog', label: t.nav.blog },
	{ key: 'docs', label: t.nav.docs },
] as const;
const other = locales.find((l) => l !== locale)!;
---

<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		{locales.map((l) => <link rel="alternate" hreflang={l} href={new URL(switchLocale(Astro.url.pathname, l), Astro.site)} />)}
		<title>{fullTitle}</title>
	</head>
	<body>
		<header class="top">
			<nav class="wrap">
				<a class="brand mono" href={href(locale)}>0x00</a>
				<div class="links">
					{nav.map((n) => (
						<a href={href(locale, `/${n.key}/`)} aria-current={section === n.key ? 'page' : undefined}>
							{n.label}
						</a>
					))}
					<a class="lang" href={switchLocale(Astro.url.pathname, other)} hreflang={other} lang={other}>
						{ui[other].langName}
					</a>
				</div>
			</nav>
		</header>
		<main class="wrap">
			<slot />
		</main>
		<footer class="wrap foot">
			<span class="mono">0x00.community</span>
			<a href="https://github.com/0x00-Community">GitHub</a>
		</footer>
	</body>
</html>

<style is:global>
	:root {
		--bg: #0b0d10;
		--fg: #e6e8eb;
		--muted: #8b939e;
		--line: #222831;
		--code: #14181d;
		--accent: #4ade80;
		color-scheme: dark;
		font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', 'PingFang SC', 'Noto Sans CJK SC', sans-serif;
	}
	@media (prefers-color-scheme: light) {
		:root {
			--bg: #fbfbfa;
			--fg: #16181c;
			--muted: #5d6570;
			--line: #e3e5e8;
			--code: #f1f2f4;
			--accent: #15803d;
			color-scheme: light;
		}
	}
	* { box-sizing: border-box; }
	body { margin: 0; background: var(--bg); color: var(--fg); line-height: 1.65; }
	a { color: inherit; }
	code, pre, .mono { font-family: ui-monospace, 'JetBrains Mono', Menlo, monospace; }
	.wrap { max-width: 860px; margin: 0 auto; padding: 0 16px; }
	.top { border-bottom: 1px solid var(--line); }
	.top nav { display: flex; align-items: center; justify-content: space-between; height: 56px; gap: 16px; }
	.brand { color: var(--accent); font-weight: 700; text-decoration: none; font-size: 1.1rem; }
	.links { display: flex; gap: 20px; align-items: center; font-size: 0.95rem; }
	.links a { text-decoration: none; color: var(--muted); }
	.links a:hover, .links a[aria-current='page'] { color: var(--fg); }
	.links .lang { border: 1px solid var(--line); border-radius: 6px; padding: 2px 8px; }
	main.wrap { padding-top: 48px; padding-bottom: 48px; min-height: calc(100vh - 160px); }
	.foot { display: flex; justify-content: space-between; color: var(--muted); font-size: 0.85rem; padding-top: 24px; padding-bottom: 32px; border-top: 1px solid var(--line); }
	.foot a { text-decoration: none; }
	.page-title { font-size: clamp(1.8rem, 4.5vw, 2.4rem); line-height: 1.2; margin: 0 0 8px; letter-spacing: -0.02em; }
	.lede { color: var(--muted); font-size: 1.05rem; margin: 0 0 32px; }
	.eyebrow { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); margin: 0 0 8px; }
	.list { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
	.list li { padding: 18px 0; border-bottom: 1px solid var(--line); }
	.list a.title { text-decoration: none; font-size: 1.12rem; font-weight: 600; }
	.list a.title:hover { color: var(--accent); }
	.list p { margin: 4px 0 0; color: var(--muted); }
	.meta { color: var(--muted); font-size: 0.85rem; }
	.more { color: var(--accent); text-decoration: none; font-weight: 600; }
	.prose { overflow-wrap: break-word; }
	.prose h2 { margin-top: 2em; font-size: 1.35rem; }
	.prose h3 { margin-top: 1.6em; font-size: 1.1rem; }
	.prose a { color: var(--accent); }
	.prose code { background: var(--code); padding: 0.1em 0.35em; border-radius: 4px; font-size: 0.9em; }
	.prose pre { background: var(--code) !important; padding: 14px 16px; border-radius: 8px; overflow-x: auto; }
	.prose pre code { background: none; padding: 0; }
	.prose table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; }
	.prose th, .prose td { border: 1px solid var(--line); padding: 6px 10px; text-align: left; }
	.prose blockquote { margin: 0; padding-left: 16px; border-left: 3px solid var(--line); color: var(--muted); }
	@media (max-width: 520px) {
		.links { gap: 12px; font-size: 0.9rem; }
	}
</style>
