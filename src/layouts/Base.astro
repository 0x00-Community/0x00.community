---
import Mark from '../components/Mark.astro';
import Nul from '../components/Nul.astro';
import SkinSwitch from '../components/SkinSwitch.astro';
import '../styles/smiley-sans.css';
import '../styles/skins.css';
import { href, localeOf, locales, switchLocale, ui } from '../i18n';

interface Props {
	title?: string;
	description?: string;
	/** The page lays out its own full-width bands instead of sitting in the centred column. */
	wide?: boolean;
	/** A narrower column, for pages that are mostly running text. */
	narrow?: boolean;
	/** The page has no version in the other language: where the language switch takes the reader instead (a path
	 *  without the language prefix, such as '/blog/'). No alternate link is announced for that language. */
	untranslated?: string;
	/** A page that is not a place of its own (the 404 page): it announces no language versions. */
	nowhere?: boolean;
}
const locale = localeOf(Astro.url.pathname);
const t = ui[locale];
const { title, description = t.siteDescription, wide = false, narrow = false, untranslated, nowhere = false } = Astro.props;
const fullTitle = title ? `${title} · 0x00 Community` : '0x00 Community';
const section = Astro.url.pathname.replace(/^\/zh-CN/, '').split('/')[1] ?? '';
const nav = [
	{ key: 'projects', label: t.nav.projects },
	{ key: 'events', label: t.nav.events },
	{ key: 'blog', label: t.nav.blog },
	{ key: 'docs', label: t.nav.docs },
] as const;
const other = locales.find((l) => l !== locale)!;
const switchTo = untranslated ? href(other, untranslated) : switchLocale(Astro.url.pathname, other);
---

<html lang={locale} data-skin="hardcore">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
		<link rel="apple-touch-icon" href="/brand/favicon-180.png" />
		<meta name="theme-color" content="#0D0D0C" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#F2F0EA" media="(prefers-color-scheme: light)" />
		<meta property="og:site_name" content="0x00 Community" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={new URL('/brand/banner-1500x500.png', Astro.site)} />
		<meta name="twitter:card" content="summary_large_image" />
		{!nowhere && locales.filter((l) => l === locale || !untranslated).map((l) => <link rel="alternate" hreflang={l} href={new URL(switchLocale(Astro.url.pathname, l), Astro.site)} />)}
		<!-- the slice of the display face that holds the site's own headings: on the first screen of the two looks most
		     visitors see, so it is fetched early -->
		<link rel="preload" href="/fonts/smiley/smiley-sans-core.woff2" as="font" type="font/woff2" crossorigin />
		<title>{fullTitle}</title>
		<!-- the visitor's chosen look, and whether motion is welcome, known before the first paint -->
		<script is:inline>
			try { const s = localStorage.getItem('skin'); if (s === 'color' || s === 'art') document.documentElement.dataset.skin = s; } catch {}
			// lets a part that is about to animate start from its first frame instead of its finished picture
			if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
		</script>
	</head>
	<body data-copy={t.copy} data-copied={t.copied}>
		<header class="top">
			<nav class="wrap">
				<a class="brand mono" href={href(locale)}>
					<Mark class="mark" />
					<svg class="zero only-art" viewBox="0 0 40 60" aria-hidden="true"><rect x="3" y="3" width="34" height="54" rx="17" /><path d="M8.5 48.5 31.5 11.5" /></svg>
					<span>0x00</span>
				</a>
				<div class="links disp">
					{nav.map((n) => (
						<a href={href(locale, `/${n.key}/`)} aria-current={section === n.key ? 'page' : undefined}>
							{n.label}
						</a>
					))}
					<a class="lang" href={switchTo} hreflang={other} lang={other}>
						{ui[other].langName}
					</a>
				</div>
				<span class="pick"><SkinSwitch /></span>
			</nav>
		</header>
		<slot name="band" />
		<main class:list={{ wrap: !wide, narrow }}>
			<slot />
		</main>
		<!-- NUL is a rest: it stands where the page ends. -->
		<footer class="foot">
			<div class="wrap">
				<Nul class="nul" label={t.nul} />
				<span class="end disp">{t.pageEnd}</span>
				<span class="right">
					<SkinSwitch />
					<span class="mono">0x00.community</span>
					<span>{t.tagline}</span>
					<a href="https://github.com/0x00-Foundation">GitHub</a>
				</span>
			</div>
		</footer>
		<script>
			// A copy button on every code block in running text: commands are meant to be pasted, not retyped.
			const { copy = 'Copy', copied = 'Copied' } = document.body.dataset;
			for (const pre of document.querySelectorAll<HTMLPreElement>('.prose pre')) {
				const box = document.createElement('div');
				box.className = 'code';
				pre.before(box);
				box.append(pre);
				const button = document.createElement('button');
				button.type = 'button';
				button.className = 'copy';
				button.textContent = copy;
				box.append(button);
				button.addEventListener('click', async () => {
					const text = (pre.querySelector('code') ?? pre).innerText.replace(/\n$/, '');
					try {
						await navigator.clipboard.writeText(text);
					} catch {
						// no clipboard access (an old browser, or not https): select the text so the reader can copy it
						getSelection()?.selectAllChildren(pre);
						return;
					}
					button.textContent = copied;
					button.classList.add('done');
					setTimeout(() => { button.textContent = copy; button.classList.remove('done'); }, 1600);
				});
			}
		</script>
	</body>
</html>

<style is:global>
	/* Smiley Sans (得意黑), SIL OFL 1.1, is the display face. It is served in slices: src/styles/smiley-sans.css,
	   made by scripts/split-smiley.py. Licence in /fonts/SmileySans-OFL.txt. */

	/* Ink, paper and the terminator red are the brand kit's (hardcore edition). Amber, blue and green are the colours
	   LED matrices come in: the same dot matrix, in colour. */
	:root {
		--ink: #111110;
		--paper: #f2f0ea;
		--red: #ff4a1c;
		--amber: #ffb61e;
		--blue: #2f5bff;
		--green: #22c57a;
		--terminator: var(--red);
		--disp: 'Smiley Sans', 'PingFang SC', 'Noto Sans CJK SC', system-ui, sans-serif;
		--disp-w: 400;
		--bw: 3px;
		--bw-s: 2.5px;
		--r: 16px;
		--r-pill: 999px;

		--bg: #0d0d0c;
		--fg: #edede6;
		--muted: #a3a198;
		--card: #1a1a18;
		--line: #edede6;
		--soft: #2e2e2b;
		--shadow: #4a4944;
		--code: #1c1c1a;
		--accent: #8fa6ff;
		--dot-on: #edede6;
		--dot-off: #2e2e2b;
		--nul-line: #edede6;
		color-scheme: dark;
		font-family: ui-sans-serif, system-ui, -apple-system, 'Segoe UI', 'PingFang SC', 'Noto Sans CJK SC', sans-serif;
	}
	@media (prefers-color-scheme: light) {
		:root {
			--bg: var(--paper);
			--fg: var(--ink);
			--muted: #55534c;
			--card: #fbfaf5;
			--line: var(--ink);
			--soft: #d9d6cc;
			--shadow: var(--ink);
			--code: #e8e5dc;
			--accent: #2148e0;
			--dot-on: #111110;
			--dot-off: #d9d6cc;
			--nul-line: var(--ink);
			color-scheme: light;
		}
	}
	* { box-sizing: border-box; }
	html { overflow-x: clip; }
	body { margin: 0; background: var(--bg); color: var(--fg); line-height: 1.65; }
	a { color: inherit; }
	a:focus-visible, summary:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; border-radius: 4px; }
	code, pre, .mono { font-family: ui-monospace, 'SF Mono', 'JetBrains Mono', Menlo, Consolas, monospace; }
	.disp { font-family: var(--disp); font-weight: var(--disp-w); }
	.wrap { max-width: 1120px; margin-inline: auto; padding-inline: 24px; }
	.wrap.narrow { max-width: 820px; }
	.sr-only { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }

	/* top bar */
	.top nav { display: flex; align-items: center; justify-content: space-between; height: 72px; gap: 12px; }
	.brand { display: flex; align-items: center; gap: 10px; padding: 7px 14px 7px 10px; border-radius: 10px; background: var(--ink); color: var(--paper); border: 2px solid var(--line); --dot-on: #edede6; font-weight: 700; letter-spacing: 0.04em; text-decoration: none; }
	.brand .mark { width: 22px; height: 22px; }
	.brand .zero { width: 20px; height: 30px; fill: none; stroke: currentColor; stroke-width: 3.4; }
	.top .links { margin-left: auto; }
	.top .pick { display: inline-flex; }
	.links { display: flex; align-items: center; gap: 4px; font-size: 1.15rem; }
	.links a { text-decoration: none; white-space: nowrap; padding: 3px 14px; border-radius: var(--r-pill); }
	.links a:hover, .links a[aria-current='page'] { background: var(--fg); color: var(--bg); }
	.links .lang { border: var(--bw-s) solid var(--line); font-size: 0.95rem; margin-left: 6px; }

	main { overflow-x: clip; min-height: calc(100vh - 260px); }
	main.wrap { padding-block: 48px 72px; }

	/* footer: always the dark plate */
	.foot { background: #0b0b0b; color: #edede6; --nul-line: #edede6; border-top: var(--bw) solid var(--line); }
	.foot .wrap { display: flex; align-items: center; gap: 18px; padding-block: 28px; }
	.foot .nul { height: 58px; width: auto; flex: none; }
	.foot .end { font-size: 1.35rem; }
	.foot .right { margin-left: auto; display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-end; gap: 8px 20px; color: #8f8d85; font-size: 0.88rem; }
	.foot .skins { color: #edede6; --sw-on: #edede6; --sw-on-fg: #0b0b0b; }
	.foot a { text-decoration: none; }
	.foot a:hover { color: #edede6; }

	/* full-width colour bands; inside one, outlines and cards go back to ink on paper whatever the theme */
	.band { padding-block: 64px; --line: #111110; --shadow: #111110; --nul-line: #111110; --card: #fbfaf5; --card-fg: #111110; --card-muted: #55534c; --dot-off: #dedbd0; }
	.band.blue { background: var(--blue); color: #fff; --fg: #fff; --muted: #dbe3ff; --accent: #fff; }
	.band.amber { background: var(--amber); color: #111110; --fg: #111110; --muted: #4a3a12; --accent: #111110; }
	.band.green { background: var(--green); color: #111110; --fg: #111110; --muted: #123d28; --accent: #111110; }
	.band.plate { background: #0b0b0b; color: #edede6; --fg: #edede6; --muted: #a3a198; --accent: #ffb61e; --line: #edede6; --nul-line: #edede6; }
	.band.edge { border-block: var(--bw) solid var(--line); }

	/* pieces */
	.btn { display: inline-flex; align-items: center; min-height: 50px; padding: 4px 24px; border: var(--bw) solid var(--line); border-radius: var(--r-pill); background: var(--card); color: var(--card-fg, var(--fg)); box-shadow: 4px 4px 0 var(--shadow); font-size: 1.2rem; text-decoration: none; transition: transform 0.08s, box-shadow 0.08s; }
	.btn.go { background: var(--amber); color: #111110; }
	a.btn:hover { transform: translate(-2px, -2px); box-shadow: 6px 6px 0 var(--shadow); }
	a.btn:active { transform: translate(2px, 2px); box-shadow: 2px 2px 0 var(--shadow); }
	.btn.soon { border-style: dashed; box-shadow: none; color: var(--card-muted, var(--muted)); }
	.acts { display: flex; flex-wrap: wrap; gap: 16px; }

	.card { display: flex; flex-direction: column; gap: 8px; padding: 20px 22px 22px; border: var(--bw) solid var(--line); border-radius: var(--r); background: var(--card); color: var(--card-fg, var(--fg)); box-shadow: 6px 6px 0 var(--shadow); text-decoration: none; }
	a.card, .card.link { transition: transform 0.08s, box-shadow 0.08s; }
	a.card:hover, .card.link:hover { transform: translate(-3px, -3px); box-shadow: 9px 9px 0 var(--shadow); }
	.card p { margin: 0; color: var(--card-muted, var(--muted)); font-size: 0.96rem; }
	.cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; list-style: none; padding: 0; margin: 0; }

	.chip { display: inline-block; align-self: flex-start; padding: 0 12px; border: var(--bw-s) solid var(--line); border-radius: var(--r-pill); background: var(--chip, transparent); color: var(--chip-fg, inherit); font-size: 0.98rem; line-height: 1.55; white-space: nowrap; }
	.chip.amber { --chip: var(--amber); --chip-fg: #111110; }
	.chip.green { --chip: var(--green); --chip-fg: #111110; }
	.chip.blue { --chip: #9db1ff; --chip-fg: #111110; }
	.chip.red { --chip: #ff9c80; --chip-fg: #111110; }
	.chip.dark { --chip: var(--fg); --chip-fg: var(--bg); }

	.section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin: 0 0 26px; }
	.section-head h2 { font-size: 2.3rem; line-height: 1.2; margin: 0; }
	.more { font-family: var(--disp); font-weight: var(--disp-w); font-size: 1.15rem; color: var(--accent); text-decoration: none; border-bottom: 3px solid currentColor; }
	.more:hover { border-bottom-style: dashed; }

	.page-title { font-family: var(--disp); font-weight: var(--disp-w); font-size: clamp(2.2rem, 5vw, 3.4rem); line-height: 1.15; margin: 0 0 10px; text-wrap: balance; }
	.lede { color: var(--muted); font-size: 1.08rem; margin: 0 0 32px; max-width: 44em; }
	.eyebrow { font-size: 0.95rem; color: var(--muted); margin: 0 0 10px; }
	.eyebrow a { color: inherit; text-decoration: none; border-bottom: 2px solid currentColor; }
	.list { list-style: none; padding: 0; margin: 0; border-top: var(--bw) solid var(--line); }
	.list li { padding: 18px 0; border-bottom: 1px solid var(--soft); }
	.list a.title { text-decoration: none; font-size: 1.12rem; font-weight: 600; }
	.list a.title:hover { color: var(--accent); }
	.list p { margin: 4px 0 0; color: var(--muted); }
	.meta { color: var(--muted); font-size: 0.85rem; }

	.prose { overflow-wrap: break-word; }
	.prose h2 { margin-top: 2em; font-size: 1.45rem; }
	.prose h3 { margin-top: 1.6em; font-size: 1.12rem; }
	.prose a { color: var(--accent); }
	.prose code { background: var(--code); padding: 0.1em 0.35em; border-radius: 4px; font-size: 0.9em; }
	.prose pre { background: #0b0b0b !important; padding: 16px 18px; border: var(--bw) solid var(--line); border-radius: var(--r); overflow-x: auto; tab-size: 4; }
	.prose pre code { background: none; padding: 0; }
	/* code blocks are always the dark plate, so their copy button is light on dark in every look */
	.prose .code { position: relative; }
	.prose .code pre { padding-right: 76px; }
	.prose .copy { position: absolute; top: 10px; right: 10px; padding: 2px 10px; border: 1px solid rgba(237, 237, 230, 0.28); border-radius: 6px; background: rgba(237, 237, 230, 0.06); color: #c9c7bf; font: 500 0.78rem/1.6 ui-sans-serif, system-ui, -apple-system, 'PingFang SC', sans-serif; cursor: pointer; }
	.prose .copy:hover { color: #edede6; border-color: rgba(237, 237, 230, 0.6); }
	.prose .copy:focus-visible { outline: 2px solid #edede6; outline-offset: 2px; }
	.prose .copy.done { color: #0b0b0b; background: #edede6; border-color: #edede6; }
	.prose table { border-collapse: collapse; width: 100%; display: block; overflow-x: auto; }
	.prose th, .prose td { border: 1px solid var(--soft); padding: 6px 10px; text-align: left; }
	.prose blockquote { margin: 0; padding: 2px 0 2px 16px; border-left: 4px solid var(--amber); color: var(--muted); }
	.prose img { max-width: 100%; height: auto; }

	@media (max-width: 860px) {
		.wrap { padding-inline: 16px; }
		.cards { grid-template-columns: 1fr; }
		.band { padding-block: 48px; }
		.section-head h2 { font-size: 1.9rem; }
		.foot .wrap { flex-wrap: wrap; }
		.foot .right { margin-left: 0; flex-basis: 100%; justify-content: flex-start; }
		/* no room beside the links: the switch takes a line of its own under them, with buttons a thumb can hit */
		.top nav { height: auto; padding-block: 12px 0; flex-wrap: wrap; row-gap: 10px; }
		.top .pick { flex-basis: 100%; justify-content: flex-end; padding-bottom: 10px; }
		.top .skins button, .foot .skins button { padding: 10px 16px; font-size: 0.88rem; }
		/* a link's tap area reaches 44px high without the link itself growing */
		.top .links a { position: relative; }
		.top .links a::after { content: ''; position: absolute; inset: -10px -4px; }
	}
	@media (max-width: 520px) {
		.links { font-size: 1.02rem; gap: 0; }
		.links a { padding: 3px 8px; }
		.links .lang { font-size: 0.85rem; }
		/* five links do not fit beside the wordmark on a phone: keep the mark, drop the letters */
		.brand span { display: none; }
		.brand { padding: 7px 9px; }
	}
</style>
