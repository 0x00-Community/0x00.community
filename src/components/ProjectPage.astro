---
import Base from '../layouts/Base.astro';
import PageHead from './PageHead.astro';
import ProjectGrid from './ProjectGrid.astro';
import { href, ui, type Locale } from '../i18n';
import { org, projects, type Project } from '../data/projects';

interface Props { locale: Locale; project: Project }
const { locale, project } = Astro.props;
const t = ui[locale];
const repo = `${org}/${project.name}`;
const others = projects.filter((p) => p.name !== project.name).slice(0, 3);
---

<Base title={project.name} description={project.desc[locale]}>
	<PageHead slot="band" tone="blue" title={project.name} lede={project.desc[locale]} word={project.name} mono>
		<p slot="crumb" class="eyebrow"><a href={href(locale, '/projects/')}>{t.projectsTitle}</a> / {t.kinds[project.kind]}</p>
		<p class="acts disp"><a class="btn go" href={repo}>{t.repo} →</a></p>
	</PageHead>
	<div class="section-head">
		<h2 class="disp">{t.featured}</h2>
		<a class="more" href={href(locale, '/projects/')}>{t.allProjects}</a>
	</div>
	<ProjectGrid locale={locale} projects={others} />
</Base>

<style>
	.acts { margin: 24px 0 0; }
</style>
