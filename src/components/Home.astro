---
import Base from '../layouts/Base.astro';
import Wordmark from './Wordmark.astro';
import { formatDate, href, posts, slugOf, ui, type Locale } from '../i18n';
import { projects } from '../data/projects';
import { events } from '../data/events';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
const latest = (await posts(locale)).slice(0, 3);
const event = events[0];
---

<Base>
	{event && (
		<a class="notice" href={href(locale, `/events/${event.slug}/`)}>
			<span class="dot" aria-hidden="true"></span>
			<span><b class="mono">{event.name}</b> · {event.fullName[locale]} · {event.facts[1]?.value?.[locale]}</span>
			<span class="go">{t.event.details}</span>
		</a>
	)}
	<section class="hero">
		<Wordmark class="wordmark" />
		<h1>{t.heroTitle}</h1>
		<p class="lede">{t.heroLede}</p>
		<a class="more" href={href(locale, '/docs/')}>{t.readDocs}</a>
	</section>

	<section>
		<h2 class="eyebrow">{t.featured}</h2>
		<ul class="list">
			{projects.map((p) => (
				<li>
					<a class="title mono" href={p.site?.[locale] ?? href(locale, `/projects/${p.name}/`)}>{p.name}</a>
					<p>{p.desc[locale]}</p>
				</li>
			))}
		</ul>
		<p><a class="more" href={href(locale, '/projects/')}>{t.allProjects}</a></p>
	</section>

	<section>
		<h2 class="eyebrow">{t.latest}</h2>
		<ul class="list">
			{latest.map((post) => (
				<li>
					<a class="title" href={href(locale, `/blog/${slugOf(post)}/`)}>{post.data.title}</a>
					<p>{post.data.description}</p>
					<span class="meta">{formatDate(locale, post.data.date)}</span>
				</li>
			))}
		</ul>
		<p><a class="more" href={href(locale, '/blog/')}>{t.allPosts}</a></p>
	</section>
</Base>

<style>
	.notice { display: flex; align-items: center; gap: 10px; padding: 10px 14px; margin: -16px 0 24px; border: 1px solid var(--line); border-radius: 8px; text-decoration: none; font-size: 0.92rem; }
	.notice:hover { border-color: var(--accent); }
	.notice .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--terminator); flex: none; }
	.notice .go { margin-left: auto; color: var(--accent); font-weight: 600; white-space: nowrap; }
	.hero { padding: 24px 0 16px; }
	.hero :global(.wordmark) { width: min(100%, 520px); height: auto; margin: 0 0 36px; }
	h1 { font-size: clamp(1.9rem, 5vw, 2.8rem); line-height: 1.15; margin: 0 0 20px; letter-spacing: -0.02em; }
	section + section { margin-top: 56px; }
</style>
