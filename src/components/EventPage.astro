---
import Base from '../layouts/Base.astro';
import { href, ui, type Locale } from '../i18n';
import type { Event, State } from '../data/events';

interface Props { locale: Locale; event: Event }
const { locale, event } = Astro.props;
const t = ui[locale];
const e = t.event;
const tabs = Object.entries(e.tabs) as [keyof typeof e.tabs, string][];
const tag = (state?: State) => (state === 'tentative' ? e.tentative : state === 'tbd' ? e.tbd : '');
---

<Base title={`${event.name} · ${event.fullName[locale]}`} description={event.summary[locale]}>
	<p class="eyebrow"><a href={href(locale, '/events/')}>{t.eventsTitle}</a> · {event.host[locale]}</p>

	<header class="hero">
		<h1 class="mono">{event.name}<span class="end" aria-hidden="true"></span></h1>
		<p class="full">{event.fullName[locale]}</p>
		<p class="tagline">{event.tagline[locale]}</p>
		<p class="lede">{event.summary[locale]}</p>
		<p class="cta">
			{event.registerUrl
				? <a class="btn primary" href={event.registerUrl}>{e.register} →</a>
				: <span class="btn soon">{event.registerNote[locale]}</span>}
			<a class="btn" href="#timeline">{e.seeTimeline}</a>
		</p>
		<dl class="facts">
			{event.facts.map((f) => (
				<div>
					<dt>{f.label[locale]}</dt>
					<dd class:list={{ tbd: f.state === 'tbd' }}>
						{f.state === 'tbd' ? e.tbd : f.value?.[locale]}
						{f.state === 'tentative' && <span class="tag">{e.tentative}</span>}
					</dd>
				</div>
			))}
		</dl>
	</header>

	<nav class="tabs" aria-label={event.name}>
		{tabs.map(([id, label]) => <a href={`#${id}`}>{label}</a>)}
	</nav>

	<section id="overview">
		<h2>{e.tabs.overview}</h2>
		<p>{event.summary[locale]}</p>
		<p class="note">{event.criteriaNote[locale]}</p>
		<ol class="cards three">
			{event.criteria.map((c, i) => (
				<li>
					<span class="num mono">{String(i + 1).padStart(2, '0')}</span>
					<h3>{c.title[locale]}</h3>
					<p>{c.body[locale]}</p>
				</li>
			))}
		</ol>
	</section>

	<section id="timeline">
		<h2>{e.tabs.timeline}</h2>
		<ol class="timeline">
			{event.phases.map((p) => (
				<li data-start={p.start} data-end={p.end}>
					<div class="when">
						{p.when[locale]}
						{p.state === 'tentative' && <span class="tag">{e.tentative}</span>}
					</div>
					<div class="what">
						<h3>
							{p.name[locale]}
							<span class="live now">{e.now}</span>
							<span class="live done">{e.done}</span>
						</h3>
						<p>{p.what[locale]}</p>
					</div>
				</li>
			))}
		</ol>
	</section>

	<section id="enter">
		<h2>{e.tabs.enter}</h2>
		<ol class="steps">
			{event.steps.map((s, i) => (
				<li>
					<span class="num mono">{i + 1}</span>
					<div>
						<h3>{s.title[locale]}{tag(s.state) && <span class="tag">{tag(s.state)}</span>}</h3>
						<p>{s.body[locale]}</p>
					</div>
				</li>
			))}
		</ol>
	</section>

	{([
		['projects', event.projects],
		['review', event.review],
		['scoring', event.scoring],
	] as const).map(([id, points]) => (
		<section id={id}>
			<h2>{e.tabs[id]}</h2>
			<dl class="points">
				{points.map((p) => (
					<div>
						<dt>{p.title[locale]}{p.state === 'tentative' && <span class="tag">{e.tentative}</span>}</dt>
						<dd class:list={{ tbd: p.state === 'tbd' }}>{p.state === 'tbd' ? e.tbd : p.body[locale]}</dd>
					</div>
				))}
			</dl>
			{id === 'scoring' && (
				<>
					<h3 class="sub">{e.prizes}</h3>
					<dl class="points">
						{event.prizes.map((p) => (
							<div>
								<dt>{p.title[locale]}</dt>
								<dd class:list={{ tbd: p.state === 'tbd' }}>{p.state === 'tbd' ? e.tbd : p.body[locale]}</dd>
							</div>
						))}
					</dl>
				</>
			)}
		</section>
	))}

	<section id="rules">
		<h2>{e.tabs.rules}</h2>
		<p class="note">
			{event.rulesNote[locale]}
			{event.rulesUrl && <a class="more" href={event.rulesUrl}>{e.rulesFull}</a>}
		</p>
		{event.banned.length > 0 && (
			<>
				<h3 class="sub">{e.banned}</h3>
				<ul class="cards two">
					{event.banned.map((b) => (
						<li>
							<h3><span class="x" aria-hidden="true">×</span>{b.title[locale]}</h3>
							<p>{b.body[locale]}</p>
						</li>
					))}
				</ul>
			</>
		)}
		<h3 class="sub">{e.code}</h3>
		<dl class="points">
			{event.code.map((p) => (
				<div>
					<dt>{p.title[locale]}</dt>
					<dd class:list={{ tbd: p.state === 'tbd' }}>{p.state === 'tbd' ? e.tbd : p.body[locale]}</dd>
				</div>
			))}
		</dl>
	</section>

	<section id="resources">
		<h2>{e.tabs.resources}</h2>
		<ul class="list">
			{event.resources.map((r) => (
				<li>
					{r.href
						? <a class="title" href={r.href[locale]}>{r.title[locale]} ↗</a>
						: <span class="title plain">{r.title[locale]}</span>}
					<p>{r.body[locale]}</p>
				</li>
			))}
		</ul>
	</section>

	<section id="faq">
		<h2>{e.tabs.faq}</h2>
		{event.faq.map((f) => (
			<details>
				<summary>{f.q[locale]}{f.state === 'tentative' && <span class="tag">{e.tentative}</span>}</summary>
				<p class:list={{ tbd: f.state === 'tbd' }}>{f.state === 'tbd' ? e.tbd : f.a[locale]}</p>
			</details>
		))}
	</section>

	<p class="cta end">
		{event.registerUrl
			? <a class="btn primary" href={event.registerUrl}>{e.register} →</a>
			: <span class="btn soon">{event.registerNote[locale]}</span>}
	</p>
</Base>

<script>
	// Mark the phases that are running today and the ones that are over. Dates in the data are Beijing days (UTC+8).
	const today = new Date(Date.now() + 8 * 3600 * 1000).toISOString().slice(0, 10);
	for (const li of document.querySelectorAll<HTMLElement>('.timeline li')) {
		const { start = '', end = '' } = li.dataset;
		if (today > end) li.classList.add('is-done');
		else if (today >= start) li.classList.add('is-now');
	}
</script>

<style>
	.eyebrow a { color: inherit; text-decoration: none; }
	.eyebrow a:hover { color: var(--fg); }

	.hero { padding: 8px 0 8px; }
	.hero h1 { font-size: clamp(2.6rem, 9vw, 4.6rem); line-height: 1; margin: 0; letter-spacing: -0.03em; display: flex; align-items: baseline; gap: 0.18em; flex-wrap: wrap; }
	/* the brand's terminator dot, closing the name */
	.hero h1 .end { width: 0.2em; height: 0.2em; border-radius: 50%; background: var(--terminator); flex: none; }
	.full { margin: 14px 0 0; font-size: 1.15rem; font-weight: 600; }
	.tagline { margin: 4px 0 20px; color: var(--accent); font-weight: 600; }
	.hero .lede { margin-bottom: 24px; max-width: 46em; }

	.cta { display: flex; flex-wrap: wrap; gap: 10px; margin: 0 0 32px; }
	.cta.end { margin: 56px 0 0; }
	.btn { display: inline-flex; align-items: center; height: 42px; padding: 0 18px; border: 1px solid var(--line); border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 0.95rem; }
	a.btn:hover { border-color: var(--fg); }
	.btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
	a.btn.primary:hover { filter: brightness(1.08); border-color: var(--accent); }
	.btn.soon { border-style: dashed; color: var(--muted); }

	.tag { display: inline-block; margin-left: 8px; padding: 0 6px; border: 1px solid var(--line); border-radius: 4px; color: var(--muted); font: 500 0.72rem/1.6 ui-sans-serif, system-ui, sans-serif; letter-spacing: 0.02em; vertical-align: 0.1em; white-space: nowrap; }
	.tbd { color: var(--muted); font-style: italic; }

	.facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin: 0; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
	.facts div { padding: 12px 16px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); margin: 0 -1px -1px 0; }
	.facts dt { font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
	.facts dd { margin: 2px 0 0; font-weight: 600; }

	.tabs { position: sticky; top: 0; z-index: 2; display: flex; gap: 4px 20px; margin: 40px 0 0; padding: 12px 0; background: var(--bg); border-bottom: 1px solid var(--line); overflow-x: auto; white-space: nowrap; font-size: 0.92rem; scrollbar-width: none; }
	.tabs::-webkit-scrollbar { display: none; }
	.tabs a { text-decoration: none; color: var(--muted); }
	.tabs a:hover { color: var(--fg); }

	section { padding-top: 44px; scroll-margin-top: 44px; }
	section h2 { font-size: 1.45rem; margin: 0 0 16px; letter-spacing: -0.01em; }
	h3.sub { font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); font-weight: 600; margin: 32px 0 12px; }
	.note { color: var(--muted); margin: 0 0 16px; }
	.note .more { margin-left: 8px; }

	.cards { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
	.cards.three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
	.cards.two { grid-template-columns: repeat(2, minmax(0, 1fr)); }
	.cards li { border: 1px solid var(--line); border-radius: 10px; padding: 16px; }
	.cards h3 { margin: 0 0 6px; font-size: 1.02rem; }
	.cards p { margin: 0; color: var(--muted); font-size: 0.95rem; }
	.cards .num { display: block; color: var(--accent); font-size: 0.85rem; margin-bottom: 10px; }
	.cards .x { color: var(--accent); margin-right: 8px; font-weight: 700; }

	.timeline { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
	.timeline li { display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 16px; padding: 16px 0 16px 14px; border-bottom: 1px solid var(--line); border-left: 3px solid transparent; }
	.timeline .when { font-size: 0.92rem; color: var(--muted); padding-top: 2px; font-variant-numeric: tabular-nums; }
	.timeline h3 { margin: 0 0 2px; font-size: 1.05rem; }
	.timeline p { margin: 0; color: var(--muted); }
	.live { display: none; margin-left: 8px; padding: 0 7px; border-radius: 4px; font: 600 0.72rem/1.7 ui-sans-serif, system-ui, sans-serif; vertical-align: 0.12em; }
	.live.now { background: var(--accent); color: #fff; }
	.live.done { border: 1px solid var(--line); color: var(--muted); }
	.timeline li:global(.is-now) { border-left-color: var(--accent); }
	.timeline li:global(.is-now) .live.now, .timeline li:global(.is-done) .live.done { display: inline-block; }
	.timeline li:global(.is-done) h3, .timeline li:global(.is-done) .when { color: var(--muted); }

	.steps { list-style: none; padding: 0; margin: 0; }
	.steps li { display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: 14px; padding: 0 0 20px; position: relative; }
	.steps li:not(:last-child)::before { content: ''; position: absolute; left: 15px; top: 34px; bottom: 2px; width: 1px; background: var(--line); }
	.steps .num { width: 32px; height: 32px; border: 1px solid var(--line); border-radius: 50%; display: grid; place-items: center; font-size: 0.85rem; color: var(--accent); }
	.steps h3 { margin: 3px 0 2px; font-size: 1.05rem; }
	.steps p { margin: 0; color: var(--muted); }

	.points { margin: 0; border-top: 1px solid var(--line); }
	.points div { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 20px; padding: 14px 0; border-bottom: 1px solid var(--line); }
	.points dt { font-weight: 600; }
	.points dd { margin: 0; color: var(--muted); }

	.list .plain { font-size: 1.12rem; font-weight: 600; }

	details { border-bottom: 1px solid var(--line); }
	details:first-of-type { border-top: 1px solid var(--line); }
	summary { cursor: pointer; padding: 14px 0; font-weight: 600; list-style: none; display: flex; align-items: center; }
	summary::-webkit-details-marker { display: none; }
	summary::before { content: '+'; width: 22px; color: var(--accent); font-family: ui-monospace, Menlo, monospace; flex: none; }
	details[open] summary::before { content: '−'; }
	details p { margin: 0 0 16px 22px; color: var(--muted); }

	@media (max-width: 720px) {
		.facts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
		.cards.three, .cards.two { grid-template-columns: 1fr; }
		.timeline li { grid-template-columns: 1fr; gap: 4px; }
		.points div { grid-template-columns: 1fr; gap: 2px; }
	}
</style>
