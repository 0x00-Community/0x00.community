---
// The art-edition wordmark, drawn from the brand kit's own geometry. It morphs between 0X00 and /0// on the kit's
// rhythm: seven seconds a cycle, resting on 0X00 most of the time. Both shapes have the same points in the same order,
// so the browser can interpolate the path; where it cannot, the wordmark simply stays 0X00.
import { STROKE, loopsToPath, wordAt, wordBox } from '../lib/artglyphs.js';

interface Props { class?: string }
const box = wordBox();
const pad = 24;
const at = { ox: pad - box.x0, oy: box.y1 + pad };
const from = loopsToPath(wordAt(0), at);
const to = loopsToPath(wordAt(1), at);
const css = `@keyframes art-word{0%,30%,70%,100%{d:path("${from}")}50%{d:path("${to}")}}`;
---

<svg class:list={['art-word', Astro.props.class]} role="img" aria-label="0x00" viewBox={`0 0 ${box.x1 - box.x0 + pad * 2} ${box.y1 - box.y0 + pad * 2}`}>
	<path d={from} stroke-width={STROKE} />
</svg>
<style is:inline set:html={css}></style>

<style>
	.art-word { display: block; overflow: visible; }
	path { fill: none; stroke: currentColor; stroke-linejoin: miter; stroke-miterlimit: 2.4; animation: art-word 7s ease-in-out infinite; }
	@media (prefers-reduced-motion: reduce) {
		path { animation: none; }
	}
</style>
