---
import Base from '../layouts/Base.astro';
import { href, ui, type Locale } from '../i18n';
import { events } from '../data/events';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
---

<Base title={t.eventsTitle} description={t.eventsLede}>
	<h1 class="page-title">{t.eventsTitle}</h1>
	<p class="lede">{t.eventsLede}</p>
	<ul class="list">
		{events.map((e) => (
			<li>
				<a class="title" href={href(locale, `/events/${e.slug}/`)}><span class="mono">{e.name}</span> · {e.fullName[locale]}</a>
				<p>{e.summary[locale]}</p>
				<span class="meta">{e.host[locale]} · {e.facts[1]?.value?.[locale]}</span>
			</li>
		))}
	</ul>
</Base>
