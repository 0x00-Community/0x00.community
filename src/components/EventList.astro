---
import Base from '../layouts/Base.astro';
import DotPanel from './DotPanel.astro';
import PageHead from './PageHead.astro';
import { href, ui, type Locale } from '../i18n';
import { events } from '../data/events';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
---

<Base title={t.eventsTitle} description={t.eventsLede}>
	<PageHead slot="band" tone="amber" title={t.eventsTitle} lede={t.eventsLede} word="EVENTS" />
	<ul class="events">
		{events.map((e) => (
			<li class="card link">
				<DotPanel class="sign" text={e.name} />
				<div>
					<a class="title disp" href={href(locale, `/events/${e.slug}/`)}>{e.fullName[locale]}</a>
					<p>{e.summary[locale]}</p>
					<p class="chips disp">
						<span class="chip amber">{e.facts[1]?.value?.[locale]}</span>
						<span class="chip">{e.host[locale]}</span>
					</p>
				</div>
			</li>
		))}
	</ul>
</Base>

<style>
	.events { list-style: none; padding: 0; margin: 0; display: grid; gap: 28px; }
	.events li { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 32px; align-items: center; padding: 28px; }
	.events :global(.sign) { --glow: var(--red); box-shadow: 6px 6px 0 var(--glow); }
	.title { font-size: 1.9rem; line-height: 1.25; text-decoration: none; }
	.title::after { content: ''; position: absolute; inset: 0; border-radius: 15px; }
	.events p { margin: 8px 0 0; font-size: 1rem; }
	.chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px !important; color: var(--card-fg, var(--fg)) !important; }
	@media (max-width: 860px) {
		.events li { grid-template-columns: 1fr; gap: 20px; padding: 20px; }
	}
</style>
