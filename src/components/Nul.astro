---
// NUL, the mascot: a quarter rest, exactly as engraved. In numbered notation a rest is written 0, one beat of nothing
// that still holds its place, which is what the byte 0x00 (NUL in ASCII) is. A proposal on top of the brand kit, not
// part of it. The outline is the quarter rest (U+1D13D) of Noto Music, SIL OFL 1.1: licence in
// /fonts/NotoMusic-OFL.txt. It is one colour, --nul-line.
interface Props { class?: string; label?: string }
const { label } = Astro.props;
const rest = 'M51 303Q51 346 78.0 366.0Q105 386 143 386Q173 386 221 363V365L67 570Q168 659 168 736Q168 797 104 878H147L307 683Q257 624 230.0 581.0Q203 538 203 494Q203 457 227.0 416.5Q251 376 303 314L287 292Q243 320 205 320Q177 320 163.0 301.5Q149 283 149 257Q149 225 162.5 196.5Q176 168 199 142L186 123Q117 173 84.0 214.0Q51 255 51 303Z';
---

<svg class:list={['nul', Astro.props.class]} viewBox="0 0 296 795" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
	<!-- the font's outline has y pointing up -->
	<g transform="translate(-31 898) scale(1 -1)">
		<!-- a halo in the ground's colour, for when NUL stands on a field of dots; invisible unless --nul-halo is set -->
		<path class="halo" d={rest} />
		<path class="rest" d={rest} />
	</g>
</svg>

<style>
	.nul { display: block; overflow: visible; }
	.halo { fill: var(--nul-halo, none); stroke: var(--nul-halo, none); stroke-width: 64; stroke-linejoin: round; }
	.rest { fill: var(--nul-line); }
</style>
