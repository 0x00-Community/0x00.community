---
// NUL, the mascot: the brand's red terminator dot (the byte 0x00, called NUL in ASCII) with legs. A proposal on top of
// the brand kit, not part of it. The outline follows --nul-line so it reads on light and on dark ground.
interface Props { class?: string; label?: string }
const { label } = Astro.props;
---

<svg class:list={['nul', Astro.props.class]} viewBox="0 0 140 138" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
	<g class="limb">
		<path d="M55 106v24H43M85 106v24h12" />
		<path d="M112 58q20-8 18-32" />
		<path d="M27 72q-15 4-19 20" />
	</g>
	<circle class="body" cx="70" cy="66" r="46" />
	<ellipse class="shine" cx="49" cy="42" rx="12" ry="6.5" transform="rotate(-32 49 42)" />
	<ellipse class="eye" cx="57" cy="66" rx="5" ry="7.5" />
	<ellipse class="eye" cx="85" cy="66" rx="5" ry="7.5" />
	<path class="smile" d="M63 83q8 7 16 0" />
</svg>

<style>
	.nul { display: block; overflow: visible; }
	.limb { fill: none; stroke: var(--nul-line); stroke-width: 5; stroke-linecap: round; stroke-linejoin: round; }
	.body { fill: var(--terminator); stroke: var(--nul-line); stroke-width: 5; }
	.shine { fill: #fff; opacity: 0.85; }
	.eye { fill: #111110; }
	.smile { fill: none; stroke: #111110; stroke-width: 4.5; stroke-linecap: round; }
</style>
