---
// NUL, the mascot: a quarter rest with a face. In numbered notation a rest is written 0, one beat of nothing that
// still holds its place, which is what the byte 0x00 (NUL in ASCII) is. A proposal on top of the brand kit, not part
// of it. It is one colour: the body takes --nul-line, the eyes and the smile take --nul-eye (the ground behind it).
interface Props { class?: string; label?: string }
const { label } = Astro.props;
---

<svg class:list={['nul', Astro.props.class]} viewBox="0 0 150 250" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
	<!-- a halo in the ground's colour, for when NUL stands on a field of dots; invisible unless --nul-halo is set -->
	<g class="halo">
		<path d="M72 62 102 104" stroke-width="33" />
		<path d="M102 104 64 144" stroke-width="51" />
		<path d="M64 144 98 180" stroke-width="33" />
		<path d="M98 180C70 163 44 179 50 206 54 222 68 230 84 228" stroke-width="40" />
		<ellipse cx="60" cy="42" rx="36" ry="31" transform="rotate(-14 60 42)" stroke-width="20" />
	</g>
	<g class="body">
		<path d="M72 62 102 104" stroke-width="13" />
		<path d="M102 104 64 144" stroke-width="31" />
		<path d="M64 144 98 180" stroke-width="13" />
		<path d="M98 180C70 163 44 179 50 206 54 222 68 230 84 228" stroke-width="20" />
	</g>
	<ellipse class="head" cx="60" cy="42" rx="36" ry="31" transform="rotate(-14 60 42)" />
	<ellipse class="eye" cx="47" cy="40" rx="6" ry="9" />
	<ellipse class="eye" cx="72" cy="45" rx="6" ry="9" />
	<path class="smile" d="M51 58q8 7 16 3" />
</svg>

<style>
	.nul { display: block; overflow: visible; }
	.halo { fill: none; stroke: var(--nul-halo, none); stroke-linecap: round; stroke-linejoin: round; }
	.halo ellipse { fill: var(--nul-halo, none); }
	.body { fill: none; stroke: var(--nul-line); stroke-linecap: round; stroke-linejoin: round; }
	.head { fill: var(--nul-line); }
	.eye { fill: var(--nul-eye, var(--bg)); }
	.smile { fill: none; stroke: var(--nul-eye, var(--bg)); stroke-width: 4; stroke-linecap: round; }
</style>
