---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { covenants, formatDate, href, ui, type Covenant, type Locale } from '../i18n';

interface Props { locale: Locale; covenant: Covenant }
const { locale, covenant } = Astro.props;
const t = ui[locale];
const all = await covenants(locale);
const { Content } = await render(covenant);
const { title, description, version, date } = covenant.data;
const path = (v: string) => href(locale, `/covenant/LICENSE4project/${v}/`);
---

<Base title={title} description={description}>
	<article class="prose">
		<h1 class="page-title">{title}</h1>
		<p class="lede">{description}</p>
		<p class="meta">
			{t.covenantVersion} {version} · {t.covenantEffective} {formatDate(locale, date)}
			{all[0] && all[0].data.version !== version && (
				<> · <a href={path(all[0].data.version)}>{t.covenantLatest} {all[0].data.version}</a></>
			)}
		</p>
		<Content />
		{all.length > 1 && (
			<ul class="versions">
				{all.map((c) => (
					<li><a href={path(c.data.version)} aria-current={c.data.version === version ? 'page' : undefined}>{c.data.version}</a></li>
				))}
			</ul>
		)}
	</article>
</Base>

<style>
	.meta { color: var(--muted); }
	.versions { list-style: none; padding: 0; display: flex; gap: 16px; }
	.versions a[aria-current='page'] { color: var(--accent); }
</style>
