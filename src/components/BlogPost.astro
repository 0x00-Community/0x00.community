---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, href, ui, type Locale, type Post } from '../i18n';

interface Props { locale: Locale; post: Post }
const { locale, post } = Astro.props;
const t = ui[locale];
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description} narrow>
	<p class="eyebrow"><a href={href(locale, '/blog/')}>{t.blogTitle}</a></p>
	<article class="prose">
		<h1 class="page-title">{post.data.title}</h1>
		<p class="by">
			<time class="chip green mono" datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(locale, post.data.date)}</time>
			<span class="meta">{t.by} {post.data.author}</span>
		</p>
		<Content />
	</article>
	<p class="back"><a class="more" href={href(locale, '/blog/')}>{t.back}</a></p>
</Base>

<style>
	.by { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; margin: 14px 0 36px; }
	.by time { font-size: 0.82rem; }
	.back { margin-top: 56px; }
</style>
