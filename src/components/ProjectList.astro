---
import Base from '../layouts/Base.astro';
import PageHead from './PageHead.astro';
import ProjectGrid from './ProjectGrid.astro';
import { ui, type Locale } from '../i18n';
import { projects } from '../data/projects';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
---

<Base title={t.projectsTitle} description={t.projectsLede}>
	<PageHead slot="band" tone="blue" title={t.projectsTitle} lede={t.projectsLede} word="PROJECTS" />
	<ProjectGrid locale={locale} projects={projects} repo />
</Base>
