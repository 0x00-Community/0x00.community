---
import Base from '../layouts/Base.astro';
import PageHead from './PageHead.astro';
import ProjectCard from './ProjectCard.astro';
import { ui, type Locale } from '../i18n';
import { projects } from '../data/projects';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
---

<Base title={t.projectsTitle} description={t.projectsLede}>
	<PageHead slot="band" tone="blue" title={t.projectsTitle} lede={t.projectsLede} word="PROJECTS" />
	<ul class="cards">
		{projects.map((p) => <li><ProjectCard locale={locale} project={p} repo /></li>)}
	</ul>
</Base>
