---
import Base from '../layouts/Base.astro';
import PageHead from './PageHead.astro';
import { formatDate, href, posts, slugOf, ui, type Locale } from '../i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale];
const all = await posts(locale);
---

<Base title={t.blogTitle} description={t.blogLede}>
	<PageHead slot="band" tone="green" title={t.blogTitle} lede={t.blogLede} word="BLOG" />
	<ul class="posts">
		{all.map((post) => (
			<li>
				<time class="chip dark mono" datetime={post.data.date.toISOString().slice(0, 10)}>{formatDate(locale, post.data.date)}</time>
				<div>
					<a class="title disp" href={href(locale, `/blog/${slugOf(post)}/`)}>{post.data.title}</a>
					<p>{post.data.description}</p>
					<span class="meta">{t.by} {post.data.author}</span>
				</div>
			</li>
		))}
	</ul>
</Base>

<style>
	.posts { list-style: none; padding: 0; margin: 0; border-top: var(--bw) solid var(--line); }
	.posts li { position: relative; display: grid; grid-template-columns: 190px minmax(0, 1fr); gap: 24px; padding: 26px 0; border-bottom: 1px solid var(--soft); align-items: start; }
	.posts time { justify-self: start; font-size: 0.82rem; margin-top: 8px; }
	.title { font-size: 1.7rem; line-height: 1.3; text-decoration: none; }
	/* the whole row is the link to the post: the title's link stretches over it, and pointing anywhere on the row
	   underlines the title */
	.title::after { content: ''; position: absolute; inset: 0; }
	.posts li:hover .title { color: var(--accent); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 6px; }
	.title:focus-visible { outline: none; }
	.posts li:has(.title:focus-visible) { outline: 3px solid var(--accent); outline-offset: 4px; border-radius: 4px; }
	.posts p { margin: 6px 0 8px; color: var(--muted); max-width: 46em; }
	@media (max-width: 720px) {
		.posts li { grid-template-columns: 1fr; gap: 6px; padding: 20px 0; }
		.posts time { margin: 0; }
		.title { font-size: 1.45rem; }
	}
</style>
