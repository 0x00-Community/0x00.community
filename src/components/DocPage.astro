---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from './PageHead.astro';
import { docs, href, slugOf, ui, type Doc, type Locale } from '../i18n';

interface Props { locale: Locale; doc?: Doc }
const { locale } = Astro.props;
const t = ui[locale];
const all = await docs(locale);
const doc = Astro.props.doc ?? all[0]!;
const { Content } = await render(doc);
const current = slugOf(doc);
---

<Base title={doc.data.title} description={doc.data.description}>
	<PageHead slot="band" tone="plate" title={doc.data.title} lede={doc.data.description} word="DOCS">
		<p slot="crumb" class="eyebrow">{t.docsTitle}</p>
	</PageHead>
	<div class="docs">
		<aside>
			<ul class="disp">
				{all.map((d) => (
					<li>
						<a href={href(locale, `/docs/${slugOf(d)}/`)} aria-current={slugOf(d) === current ? 'page' : undefined}>
							{d.data.title}
						</a>
					</li>
				))}
			</ul>
		</aside>
		<article class="prose">
			<Content />
		</article>
	</div>
</Base>

<style>
	.docs { display: grid; grid-template-columns: 220px minmax(0, 720px); gap: 56px; }
	aside ul { list-style: none; padding: 0; margin: 0; position: sticky; top: 24px; display: grid; gap: 8px; }
	aside a { display: block; padding: 4px 16px; border: 2.5px solid transparent; border-radius: var(--r-pill); text-decoration: none; font-size: 1.15rem; }
	aside a:hover { border-color: var(--line); }
	aside a[aria-current='page'] { background: var(--amber); color: #111110; border-color: var(--line); box-shadow: 3px 3px 0 var(--shadow); }
	.prose > :global(:first-child) { margin-top: 0; }
	@media (max-width: 860px) {
		.docs { grid-template-columns: minmax(0, 1fr); gap: 28px; }
		aside ul { position: static; display: flex; flex-wrap: wrap; }
	}
</style>
