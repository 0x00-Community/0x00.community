---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { docs, href, slugOf, ui, type Doc, type Locale } from '../i18n';

interface Props { locale: Locale; doc?: Doc }
const { locale } = Astro.props;
const t = ui[locale];
const all = await docs(locale);
const doc = Astro.props.doc ?? all[0]!;
const { Content } = await render(doc);
const current = slugOf(doc);
---

<Base title={doc.data.title} description={doc.data.description}>
	<div class="docs">
		<aside>
			<p class="eyebrow">{t.docsTitle}</p>
			<ul>
				{all.map((d) => (
					<li>
						<a href={href(locale, `/docs/${slugOf(d)}/`)} aria-current={slugOf(d) === current ? 'page' : undefined}>
							{d.data.title}
						</a>
					</li>
				))}
			</ul>
		</aside>
		<article class="prose">
			<h1 class="page-title">{doc.data.title}</h1>
			<p class="lede">{doc.data.description}</p>
			<Content />
		</article>
	</div>
</Base>

<style>
	.docs { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 40px; }
	aside ul { list-style: none; padding: 0; margin: 0; }
	aside li { margin: 6px 0; }
	aside a { text-decoration: none; color: var(--muted); }
	aside a:hover, aside a[aria-current='page'] { color: var(--accent); }
	@media (max-width: 720px) {
		.docs { grid-template-columns: 1fr; gap: 16px; }
		aside ul { display: flex; flex-wrap: wrap; gap: 4px 16px; }
	}
</style>
