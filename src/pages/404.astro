---
// One page for every address that is not there, whatever its language: it cannot know which one was asked for, so it
// answers in both.
import Base from '../layouts/Base.astro';
import DotPanel from '../components/DotPanel.astro';
import Nul from '../components/Nul.astro';
import { href, locales, ui } from '../i18n';
---

<Base title="404">
	<div class="lost">
		<div class="stage">
			<DotPanel class="sign" text="404" label="404" />
			<Nul class="nul" />
		</div>
		<div>
			{locales.map((l) => (
				<section lang={l}>
					<h1 class="page-title">{ui[l].notFound}</h1>
					<p class="lede">{ui[l].notFoundLede}</p>
					<p><a class="more" href={href(l)}>{ui[l].backHome}</a></p>
				</section>
			))}
		</div>
	</div>
</Base>

<style>
	.lost { display: grid; grid-template-columns: minmax(0, 360px) minmax(0, 1fr); gap: 64px; align-items: center; padding-top: 40px; }
	.stage { position: relative; padding-top: 70px; transform: rotate(-2deg); }
	.stage :global(.sign) { --led: var(--amber); --glow: var(--blue); }
	.stage :global(.nul) { position: absolute; height: 112px; width: auto; left: 80%; bottom: calc(100% - 80px); transform: rotate(6deg); transform-origin: 50% 100%; }
	section + section { margin-top: 40px; padding-top: 32px; border-top: 1px solid var(--soft); }
	.lede { margin-bottom: 16px; }
	@media (max-width: 720px) {
		.lost { grid-template-columns: 1fr; gap: 36px; padding-top: 0; }
		.stage { max-width: 300px; }
	}
</style>
