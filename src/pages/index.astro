---
import Base from '../layouts/Base.astro';

const projects = [
	{ name: 'j8', desc: 'A JavaScript engine written from scratch in Rust, layered like V8: bytecode interpreter, MLIR-based JIT and its own GC.' },
	{ name: 'paragc', desc: 'A parallel garbage collector for Rust: Immix-style mark-region heap, concurrent marking and sweeping, lock-free.' },
	{ name: 'detour', desc: 'A GPU userspace driver written entirely in Rust, generating command streams and shader code through MLIR.' },
	{ name: 'knovid', desc: 'An AI tool that helps everyday creators make clear, beautiful knowledge videos.' },
];
const org = 'https://github.com/0x00-Community';
---

<Base title="0x00 Community" description="0x00 is an open-source community building vendor-neutral systems software: compilers, runtimes, GPU and NPU toolchains.">
	<main>
		<header>
			<p class="mono mark">0x00</p>
			<h1>Open systems software, built in the open.</h1>
			<p class="lede">
				0x00 is a vendor-neutral open-source community for compilers, language runtimes, garbage collectors,
				GPU drivers and AI accelerator toolchains. Anyone can use it, anyone can contribute.
			</p>
			<p class="cta"><a href={org}>GitHub →</a></p>
		</header>

		<section>
			<h2>Projects</h2>
			<ul class="projects">
				{projects.map((p) => (
					<li>
						<a href={`${org}/${p.name}`}><span class="mono">{p.name}</span></a>
						<p>{p.desc}</p>
					</li>
				))}
			</ul>
		</section>

		<footer>
			<span class="mono">0x00.community</span>
		</footer>
	</main>
</Base>

<style>
	main { max-width: 760px; margin: 0 auto; padding: 72px 16px 48px; }
	.mark { color: var(--accent); font-size: 1.1rem; margin: 0 0 12px; }
	h1 { font-size: clamp(1.9rem, 5vw, 2.8rem); line-height: 1.15; margin: 0 0 20px; letter-spacing: -0.02em; }
	.lede { color: var(--muted); font-size: 1.1rem; margin: 0; }
	.cta a { color: var(--accent); text-decoration: none; font-weight: 600; }
	section { margin-top: 64px; }
	h2 { font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
	.projects { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--line); }
	.projects li { padding: 18px 0; border-bottom: 1px solid var(--line); }
	.projects a { text-decoration: none; font-size: 1.15rem; font-weight: 600; }
	.projects a:hover { color: var(--accent); }
	.projects p { margin: 4px 0 0; color: var(--muted); }
	footer { margin-top: 64px; color: var(--muted); font-size: 0.85rem; }
</style>
