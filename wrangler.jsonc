{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-17",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "0x00-community",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"routes": [
		{ "pattern": "0x00.community", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "STAR_HUNTER_DB",
			"database_name": "star-hunter",
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations/star-hunter"
		}
	],
	"observability": {
		"enabled": false
	}
}